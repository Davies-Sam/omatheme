#!/bin/bash

# Omatheme's palette domain: read and write the color keys of the current
# theme's colors.toml, and fork the theme into a new editable copy. Each
# panel in the app gets a helper like this, so every change the GUI can make
# is also reachable from a shell.
#
# The palette is every `key = "#rrggbb"` entry in colors.toml. `mode` and the
# hyprland_* border keys live in the same file but are not palette colors --
# the borders belong to omatheme-border -- so this helper refuses to touch
# them. Edits are surgical line replacements: a set/reset round trip leaves
# the file byte-identical.
#
# Applying goes through `omarchy theme set`, which regenerates 20+ files: the
# right thing for a Preview/Apply button, far too slow for live-on-drag.

set -euo pipefail

source "$(dirname "$0")/omatheme-lib"

is_palette_key() {
  [[ $1 != mode && $1 != hyprland_* ]]
}

# Rewrite the named keys' values in place. A key that is not in the file is
# an error -- the palette edits what a theme defines, it does not grow it.
edit_keys() {
  python3 - "$@" <<'PY'
import re
import sys

path, *pairs = sys.argv[1:]
with open(path) as handle:
    text = handle.read()

missing = []
for i in range(0, len(pairs), 2):
    key, value = pairs[i], pairs[i + 1]
    pattern = re.compile(rf'^({re.escape(key)}\s*=\s*)"[^"]*"', re.M)
    text, count = pattern.subn(rf'\g<1>"{value}"', text, count=1)
    if not count:
        missing.append(key)

if missing:
    print(f"no such key in this theme: {', '.join(missing)}", file=sys.stderr)
    sys.exit(1)

with open(path, 'w') as handle:
    handle.write(text)
PY
}

cmd_show() {
  local slug source
  slug=$(current_slug)
  source=$(source_colors "$slug")

  python3 - "$slug" "$source" "$USER_THEMES" "$OMARCHY" <<'PY'
import json
import os
import re
import sys

slug, source, user_themes, omarchy = sys.argv[1:5]

colors = {}
mode = "dark"
with open(source) as handle:
    for line in handle:
        stripped = line.strip()
        mode_match = re.match(r'^mode\s*=\s*"(light|dark)"', stripped)
        if mode_match:
            mode = mode_match.group(1)
            continue
        match = re.match(r'^(\w+)\s*=\s*"(#[0-9a-fA-F]{6,8})"', stripped)
        if match and not match.group(1).startswith('hyprland_'):
            colors[match.group(1)] = match.group(2)

print(json.dumps({
    "slug": slug,
    "editable": source.startswith(user_themes),
    # Whether `reset` has a stock copy to fall back on.
    "stock": os.path.isfile(os.path.join(omarchy, "themes", slug, "colors.toml")),
    "mode": mode,
    "colors": colors,
}))
PY
}

cmd_set() {
  local slug target key
  local -a edits=()

  while (($#)); do
    [[ $1 == --* ]] || die "expected --<key>, got '$1'"
    key=${1#--}
    key=${key//-/_}
    is_palette_key "$key" || die "'$key' is not a palette color"
    [[ ${2:-} =~ ^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$ ]] || die "--$key needs a #rrggbb value"
    edits+=("$key" "$2")
    shift 2
  done

  ((${#edits[@]})) || die "set needs at least one --<key> <hex>"

  slug=$(current_slug)
  target=$(writable_colors "$slug")
  edit_keys "$target" "${edits[@]}"
  apply_theme "$slug"
  echo "$target"
}

cmd_reset() {
  local slug stock target key
  local -a edits=()

  slug=$(current_slug)
  stock="$OMARCHY/themes/$slug/colors.toml"
  [[ -f $stock ]] || die "theme '$slug' has no stock copy to reset to"

  # Nothing to reset if the theme was never overlaid.
  [[ -f $USER_THEMES/$slug/colors.toml ]] || { apply_theme "$slug"; return 0; }
  target="$USER_THEMES/$slug/colors.toml"

  local -a keys=()
  if (($# == 0)) || [[ $1 == --all ]]; then
    # Every palette key the stock file defines.
    while IFS= read -r key; do keys+=("$key"); done < <(
      grep -oP '^\w+(?=\s*=\s*"#[0-9a-fA-F]{6,8}")' "$stock" | grep -v '^mode$' | grep -v '^hyprland_' || true
    )
  else
    while (($#)); do
      [[ $1 == --* ]] || die "expected --<key>, got '$1'"
      key=${1#--}
      key=${key//-/_}
      is_palette_key "$key" || die "'$key' is not a palette color"
      keys+=("$key")
      shift
    done
  fi

  for key in "${keys[@]}"; do
    local value
    value=$(grep -oP "^${key}\s*=\s*\"\K[^\"]*" "$stock" | head -1)
    [[ $value ]] || die "stock theme has no key '$key'"
    edits+=("$key" "$value")
  done

  ((${#edits[@]})) && edit_keys "$target" "${edits[@]}"
  apply_theme "$slug"
}

cmd_fork() {
  local new=${1:-} slug stock user target
  [[ $new ]] || die "fork needs a new theme slug"
  [[ $new =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug must be lowercase letters, digits and dashes"

  slug=$(current_slug)
  target="$USER_THEMES/$new"
  [[ -e $target ]] && die "theme '$new' already exists"

  stock="$OMARCHY/themes/$slug"
  user="$USER_THEMES/$slug"
  [[ -d $stock || -d $user ]] || die "theme '$slug' has no files to fork"

  # Layer the copy the way Omarchy resolves the theme itself: stock files
  # first, then whatever the user has overlaid on top.
  mkdir -p "$target"
  [[ -d $stock ]] && cp -r "$stock/." "$target/"
  [[ -d $user ]] && cp -r "$user/." "$target/"

  # The parent's shell.<section>.toml files and keyboard.rgb are pins:
  # they override what `omarchy theme set` derives from colors.toml,
  # which would freeze the fork's lock screen and keyboard at the
  # parent's palette. Drop them so the fork derives. A full shell.toml
  # is a deliberate whole-file replacement and stays.
  local pin
  for pin in "$target"/shell.*.toml "$target/keyboard.rgb"; do
    if [[ -e $pin && ${pin##*/} != shell.toml ]]; then
      rm -f "$pin"
    fi
  done

  echo "$target"
}

# Generate a candidate palette from an image. ImageMagick quantizes the
# image to a weighted histogram; the role assignment is heuristic: the most
# common dark (or light) tone anchors the backgrounds, the most legible
# opposite tone the foregrounds, the most saturated mid-tone becomes accent,
# the eight named colors are nearest-matched by hue with synthesized
# fallbacks, brights are lightened derivatives, and mode comes from the
# weighted luminance. Prints JSON only; --apply writes the keys that exist
# in the theme through the normal edit path and applies.
generate_json() {
  python3 - "$1" <<'PY'
import colorsys
import json
import re
import subprocess
import sys

# A heredoc script occupies stdin, so the histogram cannot be piped in;
# run the quantization from here instead.
hist = subprocess.run(
    ["magick", sys.argv[1], "-resize", "128x128!", "-colors", "64",
     "-depth", "8", "-format", "%c", "histogram:info:-"],
    capture_output=True, text=True, check=True).stdout

colors = []
for line in hist.splitlines():
    match = re.search(r'^\s*(\d+):\s*\(\s*(\d+),\s*(\d+),\s*(\d+)', line)
    if match:
        count, r, g, b = (int(x) for x in match.groups())
        colors.append((count, r / 255, g / 255, b / 255))

if not colors:
    print("no colors extracted from image", file=sys.stderr)
    sys.exit(1)

total = sum(c[0] for c in colors)

def luma(r, g, b):
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def rel_lum(r, g, b):
    lin = [v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4 for v in (r, g, b)]
    return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2]

def contrast(a, b):
    la, lb = rel_lum(*a), rel_lum(*b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)

def hex_of(rgb):
    return "#%02x%02x%02x" % tuple(round(max(0, min(1, v)) * 255) for v in rgb)

def hsv_of(rgb):
    return colorsys.rgb_to_hsv(*rgb)

def rgb_of(h, s, v):
    return colorsys.hsv_to_rgb(h % 1.0, max(0, min(1, s)), max(0, min(1, v)))

def mix(a, b, t):
    return tuple(a[i] * (1 - t) + b[i] * t for i in range(3))

def scale_v(rgb, f, add=0.0):
    h, s, v = hsv_of(rgb)
    return rgb_of(h, s, v * f + add)

avg = sum(c * luma(r, g, b) for c, r, g, b in colors) / total
mode = "dark" if avg < 0.5 else "light"
dark = mode == "dark"

def pick(cands, key):
    return max(cands, key=key) if cands else None

# Backgrounds anchor on the most common tone from the image's own end of
# the range; foregrounds on the most common legible opposite tone.
if dark:
    bgs = [c for c in colors if luma(*c[1:]) < 0.30]
    fgs = [c for c in colors if luma(*c[1:]) > 0.60]
else:
    bgs = [c for c in colors if luma(*c[1:]) > 0.70]
    fgs = [c for c in colors if luma(*c[1:]) < 0.40]

bg = pick(bgs, lambda c: c[0])
bg = bg[1:] if bg else ((0.10, 0.11, 0.15) if dark else (0.93, 0.92, 0.90))
fg = pick(fgs, lambda c: c[0])
fg = fg[1:] if fg else ((0.80, 0.82, 0.88) if dark else (0.15, 0.15, 0.18))

# Legibility is non-negotiable: push the foreground away from the
# background until it reads.
step = 0
while contrast(fg, bg) < 4.5 and step < 20:
    fg = scale_v(fg, 1.15, 0.02) if dark else scale_v(fg, 0.82)
    step += 1

sat_pool = [c for c in colors
            if hsv_of(c[1:])[1] > 0.35 and 0.20 < luma(*c[1:]) < 0.80]
acc = pick(sat_pool, lambda c: hsv_of(c[1:])[1] * (c[0] ** 0.5))
accent = acc[1:] if acc else rgb_of(0.6, 0.55, 0.75 if dark else 0.55)
step = 0
while contrast(accent, bg) < 3 and step < 20:
    accent = scale_v(accent, 1.12, 0.02) if dark else scale_v(accent, 0.85)
    step += 1

# The eight named colors: nearest extracted hue wins, clamped into a
# readable band; otherwise synthesized at the target hue with the image's
# general saturation so the set still feels of a piece.
avg_sat = sum(c[0] * hsv_of(c[1:])[1] for c in colors) / total
base_s = max(0.40, min(0.75, avg_sat * 1.6 + 0.25))
base_v = (0.72 if dark else 0.52)

def hue_dist(a, b):
    d = abs(a - b)
    return min(d, 1 - d)

def named(target_deg, v_range, s_range):
    target = target_deg / 360
    cands = []
    for count, r, g, b in colors:
        h, s, v = hsv_of((r, g, b))
        if s > 0.30 and 0.15 < v < 0.95 and hue_dist(h, target) < 40 / 360:
            cands.append((count / (1 + hue_dist(h, target) * 20), h))
    h = max(cands)[1] if cands else target
    s = max(s_range[0], min(s_range[1], base_s))
    v = max(v_range[0], min(v_range[1], base_v))
    return rgb_of(h, s, v)

v_named = (0.55, 0.85) if dark else (0.35, 0.65)
s_named = (0.35, 0.90)
names = {
    "red": named(0, v_named, s_named),
    "orange": named(30, v_named, s_named),
    "yellow": named(50, v_named, s_named),
    "green": named(120, v_named, s_named),
    "cyan": named(185, v_named, s_named),
    "blue": named(220, v_named, s_named),
    "magenta": named(300, v_named, s_named),
    "brown": named(28, (0.30, 0.55), (0.30, 0.60)),
}

def brighten(rgb):
    h, s, v = hsv_of(rgb)
    return rgb_of(h, max(0, s - 0.05), min(1, v + 0.15))

out = {"accent": accent,
       "selection": mix(accent, bg, 0.65),
       "muted": mix(fg, bg, 0.65),
       "background": bg,
       "dark_background": scale_v(bg, 0.82) if dark else scale_v(bg, 0.94),
       "darker_background": scale_v(bg, 0.62) if dark else scale_v(bg, 0.88),
       "lighter_background": scale_v(bg, 1.45, 0.04) if dark else scale_v(bg, 1.03, 0.02),
       "foreground": fg,
       "dark_foreground": mix(fg, bg, 0.55),
       "light_foreground": mix(fg, bg, 0.15),
       "bright_foreground": brighten(fg)}
out.update(names)
for key in ("red", "yellow", "green", "cyan", "blue", "magenta"):
    out["bright_" + key] = brighten(out[key])

print(json.dumps({"mode": mode,
                  "colors": {k: hex_of(v) for k, v in out.items()}}))
PY
}

cmd_generate() {
  local image=${1:-} apply=no
  [[ $image ]] || die "generate needs an image path"
  [[ -f $image ]] || die "no such image '$image'"
  [[ ${2:-} == --apply ]] && apply=yes

  local json
  json=$(generate_json "$image")

  if [[ $apply == no ]]; then
    echo "$json"
    return 0
  fi

  local slug target
  slug=$(current_slug)
  target=$(writable_colors "$slug")

  # Only keys the theme actually defines go through the edit path; the
  # palette edits what a theme has, it does not grow it.
  local -a edits=()
  while IFS=$'\t' read -r key value; do
    grep -q "^${key}\s*=" "$target" && edits+=("$key" "$value")
  done < <(echo "$json" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for key, value in data["colors"].items():
    print(f"{key}\t{value}")
')
  ((${#edits[@]})) || die "none of the generated keys exist in this theme"

  edit_keys "$target" "${edits[@]}"
  edit_keys "$target" mode "$(echo "$json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["mode"])')"
  apply_theme "$slug"
  echo "$json"
}

# A fork made before cmd_fork dropped pins may still carry the parent's
# shell.<section>.toml and keyboard.rgb, freezing its lock screen and
# keyboard at the parent's palette (see cmd_fork). unpin deletes them so
# `omarchy theme set` derives both from this theme's colors.toml. No GUI
# hook: fresh forks never have the problem, so a shell verb covers the
# old ones.
cmd_unpin() {
  local slug dir pin removed=no
  slug=$(current_slug)
  theme_owned "$slug" || die "theme '$slug' is a stock theme; fork it first (omatheme-palette fork <new-slug>)"
  dir="$USER_THEMES/$slug"

  for pin in "$dir"/shell.*.toml "$dir/keyboard.rgb"; do
    if [[ -e $pin && ${pin##*/} != shell.toml ]]; then
      rm -f "$pin"
      echo "removed ${pin##*/}"
      removed=yes
    fi
  done

  if [[ $removed == yes ]]; then
    apply_theme "$slug"
  else
    echo "nothing pinned: no shell.<section>.toml or keyboard.rgb in $dir"
  fi
}

# `mode` is not a palette color -- cmd_set refuses it -- but flipping a fork
# from dark to light is theme authoring, so it gets its own verb with the
# same surgical-edit discipline. It drives GTK's prefer-dark and friends
# through the regeneration that apply_theme runs.
cmd_mode() {
  local value=${1:-} slug target
  slug=$(current_slug)

  if [[ -z $value ]]; then
    grep -oP '^mode\s*=\s*"\K[^"]*' "$(source_colors "$slug")" || echo "dark"
    return 0
  fi

  [[ $value == light || $value == dark ]] || die "mode must be 'light' or 'dark'"
  target=$(writable_colors "$slug")
  edit_keys "$target" mode "$value"
  apply_theme "$slug"
}

case ${1:-} in
show) shift; cmd_show "$@" ;;
set) shift; cmd_set "$@" ;;
reset) shift; cmd_reset "$@" ;;
mode) shift; cmd_mode "$@" ;;
generate) shift; cmd_generate "$@" ;;
fork) shift; cmd_fork "$@" ;;
unpin) shift; cmd_unpin "$@" ;;
*)
  cat >&2 <<'USAGE'
Usage:
  omatheme-palette show
  omatheme-palette set --<key> <#rrggbb>...
  omatheme-palette reset [--<key>...|--all]
  omatheme-palette mode [light|dark]
  omatheme-palette generate <image> [--apply]
  omatheme-palette fork <new-slug>
  omatheme-palette unpin

Keys are the color entries of the current theme's colors.toml, e.g.
--accent, --background, --red. The hyprland_* border keys are not
palette colors (omatheme-border owns them); `mode` has its own verb.
reset restores stock values (stock themes only); fork copies the
current theme to ~/.config/omarchy/themes/<new-slug>/; unpin removes
inherited shell.<section>.toml / keyboard.rgb pins from a user theme
so the lock screen and keyboard derive from its palette.
USAGE
  exit 1
  ;;
esac
