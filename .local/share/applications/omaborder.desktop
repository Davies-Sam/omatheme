[Desktop Entry]
Type=Application
Name=Omaborder
GenericName=Window border designer
Comment=Design the window border gradient for the current theme
Exec=omaborder
Icon=preferences-desktop-theme
Terminal=false
Categories=Utility;Settings;DesktopSettings;
Keywords=border;window;gradient;color;theme;hyprland;
# No StartupWMClass: every Quickshell process reports org.quickshell, so
# claiming it here would also claim omarchy-shell's own surfaces.
