[Desktop Entry]
Type=Application
Name=Omatheme
GenericName=Theme designer
Comment=Design the current Omarchy theme's appearance
Exec=omatheme
Icon=preferences-desktop-theme
Terminal=false
Categories=Utility;Settings;DesktopSettings;
Keywords=theme;border;window;gradient;color;palette;hyprland;
# No StartupWMClass: every Quickshell process reports org.quickshell, so
# claiming it here would also claim omarchy-shell's own surfaces.
